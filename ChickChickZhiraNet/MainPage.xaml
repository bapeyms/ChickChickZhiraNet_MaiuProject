<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ChickChickZhiraNet"
    xmlns:shared="clr-namespace:ChickChickZhiraNet.Shared;assembly=ChickChickZhiraNet.Shared"
    x:Class="ChickChickZhiraNet.MainPage"
    Title="Nutrition Tracker"
    BackgroundColor="#F5F6F1">

    <ContentPage.Resources>
        <local:MealTypeTextConverter x:Key="MealTypeTextConverter" />
        <local:MealTypeBackgroundConverter x:Key="MealTypeBackgroundConverter" />
        <local:MealTypeAccentConverter x:Key="MealTypeAccentConverter" />

        <Style TargetType="Button">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="BackgroundColor" Value="#397553" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style TargetType="Entry">
            <Setter Property="BackgroundColor" Value="#F5F6F1" />
            <Setter Property="TextColor" Value="#20352A" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <Grid
            x:Name="ResponsiveGrid"
            Padding="20"
            ColumnDefinitions="*"
            RowDefinitions="Auto,Auto"
            ColumnSpacing="22"
            RowSpacing="20"
            HorizontalOptions="Fill"
            MaximumWidthRequest="1100"
            SizeChanged="OnResponsiveGridSizeChanged">

            <VerticalStackLayout
                x:Name="MainColumn"
                Grid.Row="0"
                Grid.Column="0"
                Spacing="18">

                <VerticalStackLayout Spacing="4">
                    <Label
                        Text="Nutrition Tracker"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="#20352A" />

                    <Label
                        Text="Track your meals and daily nutrition."
                        TextColor="#68746C" />

                    <Grid
                        x:Name="DateToolbar"
                        ColumnDefinitions="Auto,*,Auto,Auto"
                        RowDefinitions="Auto"
                        ColumnSpacing="6"
                        SizeChanged="OnDateToolbarSizeChanged">

                        <Button
                            x:Name="PreviousDateButton"
                            Text="‹"
                            FontSize="24"
                            WidthRequest="44"
                            HeightRequest="44"
                            Padding="0"
                            Clicked="OnPreviousDateClicked"
                            SemanticProperties.Hint="Show the previous day" />

                        <Border
                            x:Name="DatePickerBorder"
                            Grid.Column="1"
                            Padding="8,0"
                            BackgroundColor="White"
                            Stroke="#E3E8E2"
                            StrokeShape="RoundRectangle 12">

                            <DatePicker
                                x:Name="SelectedDatePicker"
                                Format="MMM d, yyyy"
                                DateSelected="OnDateSelected"
                                HorizontalOptions="Fill"
                                TextColor="#20352A"
                                BackgroundColor="Transparent" />
                        </Border>

                        <Button
                            x:Name="NextDateButton"
                            Grid.Column="2"
                            Text="›"
                            FontSize="24"
                            WidthRequest="44"
                            HeightRequest="44"
                            Padding="0"
                            Clicked="OnNextDateClicked"
                            SemanticProperties.Hint="Show the next day" />

                        <Button
                            x:Name="TodayDateButton"
                            Grid.Column="3"
                            Text="Today"
                            BackgroundColor="#E8F2EB"
                            TextColor="#397553"
                            Clicked="OnTodayDateClicked" />
                    </Grid>
                </VerticalStackLayout>

                <Border
                    Padding="18"
                    BackgroundColor="White"
                    Stroke="#E3E8E2"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout Spacing="14">
                        <Label
                            Text="Daily Summary"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#20352A" />

                        <Grid
                            ColumnDefinitions="*,*"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="18"
                            RowSpacing="14">

                            <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                                <Label Text="Calories" TextColor="#68746C" />
                                <Label
                                    x:Name="KcalValueLabel"
                                    Text="—"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    TextColor="#20352A" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                                <Label Text="Protein" TextColor="#68746C" />
                                <Label
                                    x:Name="ProteinValueLabel"
                                    Text="—"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    TextColor="#20352A" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                                <Label Text="Fat" TextColor="#68746C" />
                                <Label
                                    x:Name="FatValueLabel"
                                    Text="—"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    TextColor="#20352A" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                                <Label Text="Carbohydrates" TextColor="#68746C" />
                                <Label
                                    x:Name="CarbsValueLabel"
                                    Text="—"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    TextColor="#20352A" />
                            </VerticalStackLayout>
                        </Grid>

                        <Label
                            Text="Daily calorie goal"
                            TextColor="#68746C" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry
                                x:Name="CalorieGoalEntry"
                                Placeholder="For example, 2000 kcal"
                                Keyboard="Numeric"
                                ReturnType="Done" />

                            <Button
                                Grid.Column="1"
                                Text="Save"
                                Clicked="OnSaveCalorieGoalClicked" />
                        </Grid>

                        <Label
                            x:Name="CalorieGoalErrorLabel"
                            Text="Enter a goal from 500 to 10000 kcal."
                            TextColor="#A13D35"
                            IsVisible="False" />

                        <ProgressBar
                            x:Name="CalorieGoalProgressBar"
                            Progress="0"
                            ProgressColor="#397553"
                            IsVisible="False" />

                        <Label
                            x:Name="TargetKcalLabel"
                            Text="No daily goal set"
                            TextColor="#68746C" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Find a food"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#20352A" />

                    <SearchBar
                        x:Name="FoodSearchBar"
                        Placeholder="For example, apple or chicken"
                        TextChanged="OnFoodSearchTextChanged"
                        Focused="OnFoodSearchFocused" />

                    <Border
                        x:Name="FoodResultsBorder"
                        IsVisible="False"
                        Padding="10"
                        BackgroundColor="White"
                        Stroke="#E3E8E2"
                        StrokeShape="RoundRectangle 14">

                        <ScrollView HeightRequest="240">
                            <VerticalStackLayout Spacing="8">
                                <ActivityIndicator
                                    x:Name="FoodLoadingIndicator"
                                    IsVisible="False"
                                    IsRunning="False"
                                    Color="#397553" />

                                <Label
                                    x:Name="FoodListMessageLabel"
                                    TextColor="#68746C" />

                                <Button
                                    x:Name="FoodRetryButton"
                                    Text="Try again"
                                    IsVisible="False"
                                    Clicked="OnFoodRetryClicked"
                                    HorizontalOptions="Start" />

                                <VerticalStackLayout
                                    BindableLayout.ItemsSource="{Binding Foods}"
                                    Spacing="8">

                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="shared:FoodDto">
                                            <Border
                                                Padding="12"
                                                BackgroundColor="#F5F6F1"
                                                Stroke="#E3E8E2"
                                                StrokeShape="RoundRectangle 12">

                                                <Grid
                                                    ColumnDefinitions="*,Auto"
                                                    ColumnSpacing="10">

                                                    <VerticalStackLayout
                                                        Spacing="3"
                                                        VerticalOptions="Center">

                                                        <Label
                                                            Text="{Binding Name}"
                                                            FontAttributes="Bold"
                                                            FontSize="16"
                                                            TextColor="#20352A" />

                                                        <Label
                                                            Text="{Binding Kcal, StringFormat='{}{0:0} kcal / 100 g'}"
                                                            TextColor="#68746C" />

                                                        <Label
                                                            Text="{Binding Protein, StringFormat='Protein {0:0.#} g'}"
                                                            TextColor="#68746C"
                                                            FontSize="12" />
                                                    </VerticalStackLayout>

                                                    <Button
                                                        Grid.Column="1"
                                                        Text="Select"
                                                        CommandParameter="{Binding .}"
                                                        Clicked="OnFoodSelected" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </ScrollView>
                    </Border>
                </VerticalStackLayout>

                <Border
                    Padding="16"
                    BackgroundColor="White"
                    Stroke="#E3E8E2"
                    StrokeShape="RoundRectangle 16">

                    <VerticalStackLayout Spacing="12">
                        <Label
                            Text="Add a meal"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#20352A" />

                        <Label
                            x:Name="SelectedFoodLabel"
                            Text="Select a food first"
                            TextColor="#68746C" />

                        <Entry
                            x:Name="GramsEntry"
                            Placeholder="Portion weight in grams"
                            Text="100"
                            Keyboard="Numeric"
                            ReturnType="Done"
                            TextChanged="OnGramsTextChanged" />

                        <Label
                            x:Name="WeightValidationLabel"
                            Text="Enter a weight from 1 to 5000 grams."
                            TextColor="#A13D35"
                            IsVisible="False" />

                        <Picker
                            x:Name="MealTypePicker"
                            Title="Meal type" />

                        <Button
                            x:Name="AddMealButton"
                            Text="Add"
                            IsEnabled="False"
                            Clicked="OnAddMealClicked" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout
                x:Name="MealsColumn"
                Grid.Row="1"
                Grid.Column="0"
                Spacing="12">

                <Label
                    Text="Meals for the day"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="#20352A" />

                <Label
                    x:Name="StatusLabel"
                    Text="Connecting to the backend…"
                    TextColor="#68746C" />

                <Border
                    x:Name="UndoBar"
                    IsVisible="False"
                    Padding="12"
                    BackgroundColor="#E8F2EB"
                    Stroke="#D3E4D8"
                    StrokeShape="RoundRectangle 12">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label
                            x:Name="UndoMessageLabel"
                            VerticalOptions="Center"
                            TextColor="#20352A" />

                        <Button
                            Grid.Column="1"
                            Text="Undo"
                            Clicked="OnUndoDeleteClicked" />
                    </Grid>
                </Border>

                <Label
                    x:Name="MealsEmptyLabel"
                    Text="No meals recorded for this day yet."
                    TextColor="#68746C"
                    IsVisible="False" />

                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding Meals}"
                    Spacing="8">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="shared:MealEntryDto">
                            <Border
                                Padding="12"
                                BackgroundColor="White"
                                Stroke="#E3E8E2"
                                StrokeShape="RoundRectangle 14">

                                <Grid
                                    ColumnDefinitions="4,*,Auto"
                                    RowDefinitions="Auto,Auto,Auto"
                                    ColumnSpacing="10"
                                    RowSpacing="6">

                                    <Border
                                        Grid.RowSpan="3"
                                        BackgroundColor="{Binding MealType, Converter={StaticResource MealTypeAccentConverter}}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 2" />

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding FoodName}"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        TextColor="#20352A" />

                                    <Button
                                        Grid.Column="2"
                                        Grid.RowSpan="3"
                                        Text="Delete"
                                        TextColor="#A13D35"
                                        BackgroundColor="#FBECE9"
                                        FontAttributes="None"
                                        CommandParameter="{Binding Id}"
                                        Clicked="OnDeleteMealClicked" />

                                    <Border
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        HorizontalOptions="Start"
                                        Padding="8,3"
                                        BackgroundColor="{Binding MealType, Converter={StaticResource MealTypeBackgroundConverter}}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8">

                                        <Label
                                            Text="{Binding MealType, Converter={StaticResource MealTypeTextConverter}}"
                                            TextColor="{Binding MealType, Converter={StaticResource MealTypeAccentConverter}}"
                                            FontSize="12"
                                            FontAttributes="Bold" />
                                    </Border>

                                    <HorizontalStackLayout
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Spacing="10">

                                        <Label
                                            Text="{Binding Grams, StringFormat='{}{0:0.#} g'}"
                                            TextColor="#68746C" />

                                        <Label
                                            Text="{Binding Kcal, StringFormat='{}{0:0} kcal'}"
                                            TextColor="#397553"
                                            FontAttributes="Bold" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>